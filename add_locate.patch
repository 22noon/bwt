+#include "bwa_fmd_index.hpp"
+
+#include <cassert>
+#include <iostream>
+#include <string>
+#include <vector>
+
+namespace {
+
+uint8_t base_code(char c)
+{
+    switch (c) {
+    case 'A': return 0;
+    case 'C': return 1;
+    case 'G': return 2;
+    case 'T': return 3;
+    default: throw std::invalid_argument("invalid DNA base");
+    }
+}
+
+SA_Range extend_right_string(
+    const BwaFMDIndex& index,
+    const std::string& pattern)
+{
+    assert(!pattern.empty());
+
+    SA_Range range = index.initial_range(base_code(pattern[0]));
+    for (size_t i = 1; i < pattern.size(); ++i)
+        range = index.extend_right(range, base_code(pattern[i]));
+    return range;
+}
+
+void assert_equal(
+    const std::vector<uint64_t>& actual,
+    const std::vector<uint64_t>& expected)
+{
+    assert(actual == expected);
+}
+
+} // namespace
+
+int main(int argc, char** argv)
+{
+    if (argc != 3) {
+        std::cerr
+            << "usage: " << argv[0]
+            << " <index.bwt> <index.sa>\n";
+        return 2;
+    }
+
+    bwt_t* bwt = bwt_restore_bwt(argv[1]);
+    assert(bwt != nullptr);
+    bwt_restore_sa(argv[2], bwt);
+
+    BwaFMDIndex index(bwt);
+
+    /* Reference used to build this BWA index: ACGTTGCA.
+     * BWA's indexed text is ACGTTGCA + TGCAACGT.
+     */
+    {
+        const auto range = index.initial_range(base_code('A'));
+        assert(range.size() == 4);
+        assert_equal(index.locate(range), {11, 12, 0, 7});
+    }
+
+    /* ACG occurs at positions 0 and 11 in the combined FMD text. */
+    {
+        const auto range = extend_right_string(index, "ACG");
+        assert(range.size() == 2);
+        assert_equal(index.locate(range), {11, 0});
+    }
+
+    /* The original reference occurs once, at position 0. */
+    {
+        const auto range = extend_right_string(index, "ACGTTGCA");
+        assert(range.size() == 1);
+        assert_equal(index.locate(range), {0});
+    }
+
+    bwt_destroy(bwt);
+
+    std::cout << "BWA locate tests passed\n";
+    return 0;
+}
